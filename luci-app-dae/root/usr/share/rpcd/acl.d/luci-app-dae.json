{
	"luci-app-dae": {
		"description": "Grant access for luci-app-dae",
		"read": {
			"ubus": {
				"luci.dae": [ "*" ]
			},
			"uci": [ "dae" ],
			"file": [
				"/etc/dae/config.dae",
				"/etc/dae/config.d/*",
				"/var/log/dae/dae.log"
			]
		},
		"write": {
			"ubus": {
				"luci.dae": [ "*" ]
			},
			"uci": [ "dae" ],
			"file": [
				"/etc/dae/config.dae",
				"/etc/dae/config.d/*",
				"/var/log/dae/dae.log"
			]
		}
	}
}
